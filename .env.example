GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL_TRANSCRIBER=gemma2-9b-it
USE_MODEL=gemini-2.5-flash-lite
LANGUAGE=es
FFMPEG_API_URL=http://ffmpeg-api:8080
POSTGRES_URL=postgresql://transcriber:transcriberpass@postgres:5432/transcriberapp
REDIS_URL=redis://redis:6379
SECRET_KEY=your-secret-key-change-in-production

# OAuth2 - External auth server
PUBLIC_OAUTH2_URL=https://oauth2.example.com
OAUTH2_URL=http://oauth2-server:8080
OAUTH2_CLIENT_ID=transcriberapp
OAUTH2_CLIENT_SECRET=your-client-secret
PUBLIC_REDIRECT_URI=https://your-domain.com/oauth/callback
OAUTH2_TOKEN_ENDPOINT=/oauth2/token
OAUTH2_USERINFO_ENDPOINT=/userinfo
